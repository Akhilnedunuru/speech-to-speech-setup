# systemd unit: hybrid speech-to-speech server (Oracle Always-Free)
# Same box as s2s.service, but STT/TTS route to RunPod serverless GPUs first,
# falling back to local CPU (faster-whisper / Kokoro) on cold start or error.
#
# Secrets live in /etc/s2s/env (chmod 600, root-owned):
#   HF_TOKEN=...
#   RUNPOD_API_KEY=...
#   RUNPOD_STT_ENDPOINT_ID=...
#   RUNPOD_TTS_ENDPOINT_ID=...
# Router files (router_plugin.py, serve_routed.py) live in /home/ubuntu/s2s-router/.
# One extra dep: /home/ubuntu/s2s/bin/pip install -r requirements-router.txt
[Unit]
Description=Speech-to-speech server with RunPod GPU routing + CPU fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/s2s/env
ExecStart=/home/ubuntu/s2s/bin/python /home/ubuntu/s2s-router/serve_routed.py \
  --host 0.0.0.0 --port 8765 \
  --stt runpod-routed --tts runpod-routed \
  --faster_whisper_stt_model_name small.en \
  --faster_whisper_stt_compute_type int8 \
  --kokoro_voice af_heart \
  --kokoro_lang_code a \
  --llm_backend responses-api \
  --model_name "openai/gpt-oss-20b:groq" \
  --responses_api_base_url "https://router.huggingface.co/v1" \
  --responses_api_api_key "${HF_TOKEN}" \
  --responses_api_stream \
  --responses_api_reasoning_effort low
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/s2s-router/server.log
StandardError=append:/home/ubuntu/s2s-router/server.log

[Install]
WantedBy=multi-user.target
